<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══ Page base ══ -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}" />
        <Setter Property="Padding"         Value="0" />
    </Style>

    <!-- ══ Shell / navigation ══ -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"       Value="{StaticResource BackgroundColor}" />
        <Setter Property="Shell.ForegroundColor"       Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.TitleColor"            Value="{StaticResource TextPrimary}" />
        <Setter Property="Shell.DisabledColor"         Value="{StaticResource TextSecondary}" />
        <Setter Property="Shell.UnselectedColor"       Value="{StaticResource TextSecondary}" />
        <Setter Property="Shell.NavBarHasShadow"       Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryAccent}" />
        <Setter Property="Shell.TabBarTitleColor"      Value="{StaticResource PrimaryAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource BackgroundColor}" />
        <Setter Property="BarTextColor"       Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ══ Typography ══ -->
    <Style x:Key="HeroTitle" TargetType="Label">
        <Setter Property="FontSize"       Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"      Value="{StaticResource TextPrimary}" />
        <Setter Property="LineBreakMode"  Value="WordWrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize"       Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"      Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize"  Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontSize"  Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- Global Label default -->
    <Style TargetType="Label">
        <Setter Property="TextColor"      Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize"       Value="14" />
    </Style>

    <!-- ══ Pill buttons ══ -->
    <Style x:Key="PrimaryPillButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccent}" />
        <Setter Property="TextColor"       Value="{StaticResource PrimaryButtonText}" />
        <Setter Property="CornerRadius"    Value="28" />
        <Setter Property="FontAttributes"  Value="Bold" />
        <Setter Property="FontSize"        Value="17" />
        <Setter Property="HeightRequest"   Value="56" />
        <Setter Property="Padding"         Value="24,0" />
        <Setter Property="BorderWidth"     Value="0" />
    </Style>

    <Style x:Key="SecondaryPillButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryButtonBackground}" />
        <Setter Property="TextColor"       Value="{StaticResource SecondaryButtonText}" />
        <Setter Property="CornerRadius"    Value="28" />
        <Setter Property="FontAttributes"  Value="Bold" />
        <Setter Property="FontSize"        Value="17" />
        <Setter Property="HeightRequest"   Value="56" />
        <Setter Property="Padding"         Value="24,0" />
        <Setter Property="BorderColor"     Value="{StaticResource SurfaceColor}" />
        <Setter Property="BorderWidth"     Value="1" />
    </Style>

    <Style x:Key="DestructivePillButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource DestructiveColor}" />
        <Setter Property="TextColor"       Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius"    Value="28" />
        <Setter Property="FontAttributes"  Value="Bold" />
        <Setter Property="FontSize"        Value="17" />
        <Setter Property="HeightRequest"   Value="56" />
        <Setter Property="Padding"         Value="24,0" />
        <Setter Property="BorderWidth"     Value="0" />
    </Style>

    <!-- Default Button global style -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccent}" />
        <Setter Property="TextColor"       Value="{StaticResource PrimaryButtonText}" />
        <Setter Property="FontSize"        Value="15" />
        <Setter Property="CornerRadius"    Value="10" />
        <Setter Property="Padding"         Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!-- ══ Cards ══ -->
    <Style x:Key="IncidentCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius"    Value="16" />
        <Setter Property="HasShadow"       Value="False" />
        <Setter Property="Padding"         Value="16" />
        <Setter Property="Margin"          Value="0,0,0,12" />
        <Setter Property="BorderColor"     Value="{StaticResource SurfaceColor}" />
    </Style>

    <!-- ══ Input fields ══ -->
    <Style x:Key="DarkEntry" TargetType="Entry">
        <Setter Property="BackgroundColor"  Value="{StaticResource CardBackground}" />
        <Setter Property="TextColor"        Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize"         Value="16" />
        <Setter Property="HeightRequest"    Value="52" />
    </Style>

    <Style x:Key="DarkEditor" TargetType="Editor">
        <Setter Property="BackgroundColor"  Value="{StaticResource CardBackground}" />
        <Setter Property="TextColor"        Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize"         Value="15" />
    </Style>

    <!-- Default Entry / Editor overrides -->
    <Style TargetType="Entry">
        <Setter Property="TextColor"        Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"  Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize"         Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor"        Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor"  Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize"         Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor"       Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor"      Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize"        Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource PrimaryAccent}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource PrimaryAccent}" />
    </Style>

    <!-- ══ Chat bubble (Assistant page) ══ -->
    <Style x:Key="UserBubble" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ActionBlue}" />
        <Setter Property="CornerRadius"    Value="18" />
        <Setter Property="HasShadow"       Value="False" />
        <Setter Property="Padding"         Value="14,10" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Margin"          Value="60,4,16,4" />
    </Style>

    <Style x:Key="AiBubble" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius"    Value="18" />
        <Setter Property="HasShadow"       Value="False" />
        <Setter Property="Padding"         Value="14,10" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="Margin"          Value="16,4,60,4" />
    </Style>

</ResourceDictionary>
