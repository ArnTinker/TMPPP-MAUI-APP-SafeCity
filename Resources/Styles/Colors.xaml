<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══ SafeCity Design System — Black & Yellow ═══ -->

    <!-- Canonical palette -->
    <Color x:Key="PrimaryBlack">#000000</Color>
    <Color x:Key="SurfaceBlack">#0D0D0D</Color>
    <Color x:Key="ElevatedBlack">#1A1A1A</Color>
    <Color x:Key="StrokeGray">#2A2A2A</Color>

    <Color x:Key="PrimaryYellow">#FFD60A</Color>
    <Color x:Key="YellowPressed">#E6C009</Color>
    <Color x:Key="YellowDim">#8A7400</Color>

    <Color x:Key="TextWhite">#FFFFFF</Color>
    <Color x:Key="TextGray">#9A9A9A</Color>
    <Color x:Key="TextOnYellow">#000000</Color>

    <!-- Semantic aliases used by Styles.xaml and views -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="CardBackground">#0D0D0D</Color>
    <Color x:Key="SurfaceColor">#1A1A1A</Color>
    <Color x:Key="DividerColor">#2A2A2A</Color>

    <Color x:Key="PrimaryAccent">#FFD60A</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#9A9A9A</Color>
    <Color x:Key="TextTertiary">#2A2A2A</Color>

    <Color x:Key="PrimaryButtonBackground">#FFD60A</Color>
    <Color x:Key="PrimaryButtonText">#000000</Color>
    <Color x:Key="SecondaryButtonBackground">#1A1A1A</Color>
    <Color x:Key="SecondaryButtonText">#FFD60A</Color>
    <Color x:Key="DestructiveColor">#8A7400</Color>

    <!-- Legacy keys for Shell/page default styles -->
    <Color x:Key="Primary">#FFD60A</Color>
    <Color x:Key="PrimaryDark">#FFD60A</Color>
    <Color x:Key="PrimaryDarkText">#000000</Color>
    <Color x:Key="Secondary">#FFD60A</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#1A1A1A</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#FFD60A</Color>
    <Color x:Key="MidnightBlue">#000000</Color>
    <Color x:Key="OffBlack">#0D0D0D</Color>
    <Color x:Key="Gray100">#1A1A1A</Color>
    <Color x:Key="Gray200">#2A2A2A</Color>
    <Color x:Key="Gray300">#3A3A3A</Color>
    <Color x:Key="Gray400">#4A4A4A</Color>
    <Color x:Key="Gray500">#9A9A9A</Color>
    <Color x:Key="Gray600">#AEAEB2</Color>
    <Color x:Key="Gray900">#E5E5EA</Color>
    <Color x:Key="Gray950">#F2F2F7</Color>

    <SolidColorBrush x:Key="PrimaryBrush"   Color="{StaticResource PrimaryYellow}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource PrimaryYellow}"/>
    <SolidColorBrush x:Key="WhiteBrush"     Color="{StaticResource TextWhite}"/>
    <SolidColorBrush x:Key="BlackBrush"     Color="{StaticResource PrimaryBlack}"/>

</ResourceDictionary>
