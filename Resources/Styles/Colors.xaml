<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══ SafeCity Design System ═══ -->
    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="CardBackground">#1C1C1E</Color>
    <Color x:Key="SurfaceColor">#2C2C2E</Color>

    <!-- Accents -->
    <Color x:Key="PrimaryAccent">#FFD60A</Color>
    <Color x:Key="ActionBlue">#2563EB</Color>
    <Color x:Key="AlertRed">#FF3B30</Color>
    <Color x:Key="PositiveGreen">#34C759</Color>
    <Color x:Key="OrangeAccent">#FF9500</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#8E8E93</Color>
    <Color x:Key="TextTertiary">#48484A</Color>

    <!-- Semantic aliases used by Styles.xaml -->
    <Color x:Key="PrimaryButtonBackground">#FFD60A</Color>
    <Color x:Key="PrimaryButtonText">#000000</Color>
    <Color x:Key="SecondaryButtonBackground">#1C1C1E</Color>
    <Color x:Key="SecondaryButtonText">#FFFFFF</Color>
    <Color x:Key="DestructiveColor">#FF3B30</Color>
    <Color x:Key="DividerColor">#2C2C2E</Color>

    <!-- Legacy keys kept so the default Shell/Page styles in Styles.xaml still compile -->
    <Color x:Key="Primary">#FFD60A</Color>
    <Color x:Key="PrimaryDark">#FFD60A</Color>
    <Color x:Key="PrimaryDarkText">#000000</Color>
    <Color x:Key="Secondary">#2563EB</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="Tertiary">#2C2C2E</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#FFD60A</Color>
    <Color x:Key="MidnightBlue">#000000</Color>
    <Color x:Key="OffBlack">#1C1C1E</Color>
    <Color x:Key="Gray100">#2C2C2E</Color>
    <Color x:Key="Gray200">#3A3A3C</Color>
    <Color x:Key="Gray300">#48484A</Color>
    <Color x:Key="Gray400">#636366</Color>
    <Color x:Key="Gray500">#8E8E93</Color>
    <Color x:Key="Gray600">#AEAEB2</Color>
    <Color x:Key="Gray900">#E5E5EA</Color>
    <Color x:Key="Gray950">#F2F2F7</Color>

    <SolidColorBrush x:Key="PrimaryBrush"   Color="{StaticResource PrimaryAccent}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ActionBlue}"/>
    <SolidColorBrush x:Key="WhiteBrush"     Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BlackBrush"     Color="{StaticResource BackgroundColor}"/>

</ResourceDictionary>
