<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeCity.Views.CreateProfilePage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <StackLayout Padding="32,60,32,48" Spacing="20" VerticalOptions="Center">

        <Label Text="Create your profile" Style="{StaticResource HeroTitle}"
               HorizontalTextAlignment="Center"/>
        <Label Text="Choose a username that the community will see."
               Style="{StaticResource BodyText}" HorizontalTextAlignment="Center"
               Margin="0,0,0,24"/>

        <Frame BackgroundColor="{StaticResource CardBackground}"
               CornerRadius="14" HasShadow="False" Padding="16,4"
               BorderColor="{StaticResource SurfaceColor}">
            <Entry Style="{StaticResource DarkEntry}"
                   Placeholder="Username"
                   Text="{Binding Username}"/>
        </Frame>

        <Label Text="{Binding UsernameStatus}"
               TextColor="{Binding UsernameAvailable,
                   Converter={x:StaticResource BoolToColorConverter},
                   ConverterParameter='#FFD60A|#9A9A9A'}"
               HorizontalTextAlignment="Center"/>

        <Button Text="Continue"
                Style="{StaticResource PrimaryPillButton}"
                Command="{Binding ContinueCommand}"
                IsEnabled="{Binding UsernameAvailable}"/>

    </StackLayout>

</ContentPage>
