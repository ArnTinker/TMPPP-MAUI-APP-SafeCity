<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeCity.Views.AlertsPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Alerts">

    <ScrollView>
        <StackLayout Padding="20,24" Spacing="20">

            <!-- Radar graphic placeholder -->
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="80" HasShadow="False"
                   WidthRequest="160" HeightRequest="160"
                   HorizontalOptions="Center" Padding="0">
                <Grid>
                    <Ellipse WidthRequest="160" HeightRequest="160"
                             Fill="Transparent"
                             Stroke="{StaticResource PrimaryYellow}"
                             StrokeThickness="2"/>
                    <Ellipse WidthRequest="110" HeightRequest="110"
                             Fill="Transparent"
                             Stroke="{StaticResource PrimaryYellow}"
                             StrokeThickness="1.5"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    <Ellipse WidthRequest="60" HeightRequest="60"
                             Fill="{StaticResource PrimaryYellow}"
                             Opacity="0.2"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    <Label Text="📡" FontSize="36"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <Label Text="Alert Radar"
                   Style="{StaticResource SectionTitle}"
                   HorizontalTextAlignment="Center"/>

            <!-- Customize CTA -->
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="16" HasShadow="False"
                   Padding="20" BorderColor="{StaticResource SurfaceColor}">
                <StackLayout Spacing="12">
                    <Label Text="Customise your alerts"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="17"/>
                    <Label Text="Set alert zones, incident types, and notification preferences."
                           Style="{StaticResource BodyText}"/>
                    <Button Text="Customise Alerts"
                            Style="{StaticResource SecondaryPillButton}"
                            Command="{Binding CustomizeAlertsCommand}"
                            HorizontalOptions="Fill"/>
                </StackLayout>
            </Frame>

            <!-- Recent alerts list -->
            <Label Text="Recent Alerts" Style="{StaticResource SectionTitle}"/>
            <CollectionView ItemsSource="{Binding RecentAlerts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource IncidentCard}">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding DefaultIcon}" FontSize="24"
                                       VerticalOptions="Center"/>
                                <StackLayout>
                                    <Label Text="{Binding Title}" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="14"/>
                                    <Label Text="{Binding Address}"
                                           Style="{StaticResource CaptionText}"/>
                                </StackLayout>
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No recent alerts. Stay safe! ✅"
                           Style="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,24"/>
                </CollectionView.EmptyView>
            </CollectionView>

        </StackLayout>
    </ScrollView>

</ContentPage>
