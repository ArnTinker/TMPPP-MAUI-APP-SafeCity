<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeCity.Views.LocationPermissionPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" Padding="32,60,32,48">

        <!-- Map placeholder visual -->
        <Frame Grid.Row="0" BackgroundColor="{StaticResource CardBackground}"
               CornerRadius="20" HasShadow="False" Margin="0,0,0,24">
            <Grid>
                <BoxView Color="{StaticResource SurfaceColor}" CornerRadius="16"/>
                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="🗺️" FontSize="64" HorizontalOptions="Center"/>
                    <Label Text="Your city, live" Style="{StaticResource BodyText}"
                           HorizontalOptions="Center"/>
                </StackLayout>
                <!-- Sample alert card overlay -->
                <Frame BackgroundColor="{StaticResource CardBackground}"
                       CornerRadius="12" HasShadow="False" Padding="12"
                       VerticalOptions="End" HorizontalOptions="Fill" Margin="16">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🔴" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Crime alert · 0.2 km away"
                               TextColor="{StaticResource TextPrimary}" FontSize="13"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Frame>
            </Grid>
        </Frame>

        <Label Grid.Row="1" Text="Allow location access"
               Style="{StaticResource SectionTitle}"
               HorizontalTextAlignment="Center"/>
        <Label Grid.Row="2"
               Text="SafeCity uses your location to route real-time alerts closest to you. Location data is deleted after 30 days."
               Style="{StaticResource BodyText}"
               HorizontalTextAlignment="Center" Margin="0,8,0,24"/>

        <Button Grid.Row="3" Text="Allow Location"
                Style="{StaticResource PrimaryPillButton}"
                Command="{Binding AllowLocationCommand}"
                HorizontalOptions="Fill"/>
        <Button Grid.Row="4" Text="Not now"
                Style="{StaticResource SecondaryPillButton}"
                Command="{Binding SkipCommand}"
                HorizontalOptions="Fill" Margin="0,12,0,0"/>
    </Grid>

</ContentPage>
