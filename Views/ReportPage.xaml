<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeCity.Views.ReportPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Go Live">

    <ScrollView>
        <StackLayout Padding="20,16" Spacing="16">

            <Label Text="Report an Incident" Style="{StaticResource SectionTitle}"/>

            <!-- Location row -->
            <Frame Style="{StaticResource IncidentCard}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding DetectedAddress}"
                           Style="{StaticResource BodyText}"
                           VerticalOptions="Center"/>
                    <Button Grid.Row="0" Grid.Column="1" Text="📍 Detect"
                            BackgroundColor="{StaticResource SurfaceColor}"
                            TextColor="{StaticResource TextPrimary}"
                            CornerRadius="10" FontSize="13"
                            HeightRequest="40" Padding="10,0"
                            Command="{Binding DetectLocationCommand}"/>
                    <!-- Green tick once location is set -->
                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                           Text="✅ Location set — ready to submit"
                           TextColor="{StaticResource PrimaryYellow}"
                           FontSize="12" Margin="0,4,0,0"
                           IsVisible="{Binding LocationDetected}"/>
                </Grid>
            </Frame>

            <!-- Type picker -->
            <Label Text="Incident Type" Style="{StaticResource BodyText}"/>
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="14" HasShadow="False" Padding="4"
                   BorderColor="{StaticResource SurfaceColor}">
                <Picker ItemsSource="{Binding IncidentTypes}"
                        SelectedItem="{Binding SelectedType}"
                        TextColor="{StaticResource TextPrimary}"/>
            </Frame>

            <!-- Severity picker -->
            <Label Text="Severity" Style="{StaticResource BodyText}"/>
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="14" HasShadow="False" Padding="4"
                   BorderColor="{StaticResource SurfaceColor}">
                <Picker ItemsSource="{Binding SeverityLevels}"
                        SelectedItem="{Binding SelectedSeverity}"
                        TextColor="{StaticResource TextPrimary}"/>
            </Frame>

            <!-- Description -->
            <Label Text="Description" Style="{StaticResource BodyText}"/>
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="14" HasShadow="False" Padding="12"
                   BorderColor="{StaticResource SurfaceColor}">
                <Editor Style="{StaticResource DarkEditor}"
                        Placeholder="What's happening? Be specific."
                        Text="{Binding Description}"
                        HeightRequest="100"/>
            </Frame>

            <!-- Attach photo -->
            <Label Text="Photos (optional)" Style="{StaticResource BodyText}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="📷 Gallery"
                        Style="{StaticResource SecondaryPillButton}"
                        Command="{Binding AttachPhotoCommand}"/>
                <Button Grid.Column="1" Text="📸 Camera"
                        Style="{StaticResource SecondaryPillButton}"
                        Command="{Binding AttachCameraCommand}"/>
            </Grid>

            <!-- Attached photo thumbnails -->
            <CollectionView ItemsSource="{Binding AttachedMedia}"
                            ItemsLayout="HorizontalList"
                            HeightRequest="88">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding .}"
                               Aspect="AspectFill"
                               WidthRequest="80" HeightRequest="80"
                               Margin="0,4,8,4"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Anonymous toggle -->
            <HorizontalStackLayout Spacing="12">
                <Switch IsToggled="{Binding IsAnonymous}"
                        OnColor="{StaticResource PrimaryAccent}"/>
                <Label Text="Report anonymously" Style="{StaticResource BodyText}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Error -->
            <Label Text="{Binding SubmitError}"
                   TextColor="{StaticResource PrimaryYellow}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding SubmitError, Converter={x:StaticResource StringNotEmptyConverter}}"/>

            <!-- Submit -->
            <Button Text="Submit Report"
                    Style="{StaticResource PrimaryPillButton}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryAccent}"
                               HorizontalOptions="Center"/>
        </StackLayout>
    </ScrollView>

</ContentPage>
