<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SafeCity.Models"
             x:Class="SafeCity.Views.NewsPage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="News">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Label Grid.Row="0" Text="SafeCity News"
               Style="{StaticResource SectionTitle}"
               Margin="20,16,20,0"/>

        <!-- Sort picker -->
        <Picker Grid.Row="1"
                ItemsSource="{Binding SortStrategies}"
                SelectedItem="{Binding ActiveSortStrategy}"
                ItemDisplayBinding="{Binding DisplayName}"
                Title="Sort by"
                Margin="20,8,20,8"
                TextColor="{StaticResource TextSecondary}"/>

        <!-- Feed -->
        <RefreshView Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="{StaticResource PrimaryAccent}">
            <CollectionView x:Name="FeedList"
                            ItemsSource="{Binding Incidents}"
                            Margin="20,0"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Incident">
                        <Frame Style="{StaticResource IncidentCard}">
                            <StackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="12">
                                    <!-- Icon — Border replaces Frame: Frame.CornerRadius as a direct
                                         attribute fails in runtime-parsed DataTemplates (MAUI .NET 10);
                                         Border.StrokeShape works correctly. -->
                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                            BackgroundColor="{StaticResource SurfaceColor}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="0"
                                            Padding="12" WidthRequest="52" HeightRequest="52"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding DefaultIcon}" FontSize="22"
                                               HorizontalOptions="Center"/>
                                    </Border>
                                    <!-- Title -->
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15" LineBreakMode="TailTruncation"/>
                                    <!-- Address -->
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Address}"
                                           Style="{StaticResource CaptionText}"/>
                                    <!-- Stats -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="16">
                                        <Label Text="{Binding UpvoteCount, StringFormat='▲ {0}'}"
                                               Style="{StaticResource CaptionText}"/>
                                        <Label Text="{Binding ViewCount, StringFormat='👁 {0}'}"
                                               Style="{StaticResource CaptionText}"/>
                                        <Label Text="{Binding CommentCount, StringFormat='💬 {0}'}"
                                               Style="{StaticResource CaptionText}"/>
                                    </HorizontalStackLayout>
                                    <!-- Severity pill — same Border fix -->
                                    <Border Grid.Row="0" Grid.Column="2"
                                            BackgroundColor="{StaticResource SurfaceColor}"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            Padding="8,4" VerticalOptions="Start">
                                        <Label Text="{Binding Severity}"
                                               Style="{StaticResource CaptionText}"
                                               TextColor="{StaticResource PrimaryAccent}"/>
                                    </Border>
                                </Grid>

                                <!-- Thumbnail loaded via CachedIncidentMediaProxy -->
                                <Image Source="{Binding ThumbnailSource}"
                                       Aspect="AspectFill"
                                       HeightRequest="140"
                                       IsVisible="{Binding ThumbnailSource,
                                           Converter={x:StaticResource NullToBoolConverter}}"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Margin="0,60,0,0">
                        <Label Text="No incidents yet." Style="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Pull to refresh or submit the first report!"
                               Style="{StaticResource CaptionText}"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
