<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeCity.Views.HomePage"
             BackgroundColor="{StaticResource BackgroundColor}"
             Title="Map">

    <Grid RowDefinitions="*,Auto">

        <!-- Map placeholder (IMapProvider abstracted behind this surface) -->
        <Grid Grid.Row="0">
            <BoxView Color="#0D1117" />
            <!-- Grid lines for map feel -->
            <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*" Opacity="0.1">
                <BoxView Grid.Row="0" Grid.ColumnSpan="4" Color="{StaticResource TextTertiary}" HeightRequest="1" VerticalOptions="Start"/>
                <BoxView Grid.Row="1" Grid.ColumnSpan="4" Color="{StaticResource TextTertiary}" HeightRequest="1" VerticalOptions="Start"/>
                <BoxView Grid.Row="2" Grid.ColumnSpan="4" Color="{StaticResource TextTertiary}" HeightRequest="1" VerticalOptions="Start"/>
            </Grid>
            <!-- User location dot -->
            <Ellipse WidthRequest="20" HeightRequest="20"
                     Fill="{StaticResource PrimaryAccent}"
                     HorizontalOptions="Center" VerticalOptions="Center"/>
            <Ellipse WidthRequest="60" HeightRequest="60"
                     Fill="{StaticResource PrimaryAccent}"
                     Opacity="0.15"
                     HorizontalOptions="Center" VerticalOptions="Center"/>

            <!-- Layer label -->
            <Frame BackgroundColor="{StaticResource CardBackground}"
                   CornerRadius="10" HasShadow="False" Padding="10,6"
                   HorizontalOptions="Start" VerticalOptions="Start" Margin="16">
                <Label Text="🗂 All Incidents" TextColor="{StaticResource TextPrimary}" FontSize="13"/>
            </Frame>

            <!-- Incident markers -->
            <CollectionView ItemsSource="{Binding NearbyIncidents}"
                            HorizontalOptions="Fill" VerticalOptions="Fill">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding DefaultIcon}" FontSize="24"
                               Margin="20,8" HorizontalOptions="Start"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- FAB report button -->
            <Button Text="+"
                    BackgroundColor="{StaticResource PrimaryAccent}"
                    TextColor="{StaticResource PrimaryButtonText}"
                    FontSize="28" FontAttributes="Bold"
                    CornerRadius="32" WidthRequest="64" HeightRequest="64"
                    HorizontalOptions="End" VerticalOptions="End"
                    Margin="20"
                    Command="{Binding GoToReportCommand}"/>
        </Grid>

        <!-- Bottom stats bar -->
        <Frame Grid.Row="1"
               BackgroundColor="{StaticResource CardBackground}"
               CornerRadius="0" HasShadow="False"
               Padding="24,16">
            <Grid ColumnDefinitions="*,*">
                <StackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="{Binding NearbyCount, StringFormat='{0}'}"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource AlertRed}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Nearby Active" Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
                <StackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{Binding NearbyUsers}"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryAccent}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Nearby Users" Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Grid>
        </Frame>

    </Grid>

</ContentPage>
