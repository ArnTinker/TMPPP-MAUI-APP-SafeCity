# SafeCity environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Google Gemini API key (AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend base URL (Render.com free tier)
BACKEND_BASE_URL=https://safecity-api.onrender.com

# Mapbox public access token (https://account.mapbox.com/access-tokens/)
# Powers the map, routing (Directions), geocoding and isochrones.
MAPBOX_TOKEN=your_pk_token_here

# Optional: custom Mapbox style URL (defaults to mapbox://styles/mapbox/dark-v11)
# MAPBOX_STYLE_URL=mapbox://styles/your-account/your-style-id
